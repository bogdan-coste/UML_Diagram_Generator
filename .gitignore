# --- Local working copies of third-party code (dataset source) ----------------
# `repos/` holds cloned upstream projects. Never commit these: they are large,
# they are not ours, and their licences vary (MIT / Apache-2.0 / BSD / others).
repos/

# --- Derived datasets and trained adapters ------------------------------------
# `data/*.jsonl` is generated from the repositories in `repos/`, and `models/`
# holds training output. Both derive from third-party code, so verify licensing
# before committing either. Un-ignore `data/` deliberately if you decide the
# derived JSONL is safe to redistribute.
data/
models/
chroma_db/

# --- Training logs -----------------------------------------------------------
*.log

# --- Local working notes ------------------------------------------------------
# Exploratory notes and design drafts, kept out of the published tree.
docs/
