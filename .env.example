# Copy to `.env` (which is gitignored) and fill in what you need.
# `src/config.py` loads this file from the project root if python-dotenv is installed.

# --- LLM client ---------------------------------------------------------------------
# Required for the `text` and `story` input modes. The `folder` and `code` modes
# run entirely on static analysis and need none of this.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Any OpenAI-compatible endpoint works. Point this at a local vLLM or Ollama
# server (e.g. http://localhost:11434/v1) to keep inference on-machine. With a
# non-default URL, an API key is optional.
LLM_BASE_URL=https://api.openai.com/v1

# Optional: sent as an `App-Id` header by some gateways.
LLM_APP_ID=

# --- API server ---------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API. Defaults to the Vite
# dev server.
# API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# How many generations GET /history keeps in memory.
# HISTORY_LIMIT=50

# --- Retrieval ----------------------------------------------------------------------
# ChromaDB vector store. Needs the `chromadb` and `sentence-transformers` extras.
# ENABLE_RAG=false
# CHROMA_PERSIST_DIR=./chroma_db
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Static analysis ----------------------------------------------------------------
# SUPPORTED_EXTENSIONS=java,py
# IGNORED_DIRS=.git,__pycache__,node_modules,venv,.venv,target,build,dist,.idea,.vscode
# DEFAULT_OUTPUT_FILENAME=architecture.puml
