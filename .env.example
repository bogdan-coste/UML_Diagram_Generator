# Architecture Diagram Generator — Environment Configuration
# Copy this to .env and adjust as needed.

# --- Ollama / SLM settings ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=phi3:mini
OLLAMA_TIMEOUT=30
OLLAMA_TEMPERATURE=0.1

# --- File ingestion ---
# Comma-separated extensions (no dots): java,py
SUPPORTED_EXTENSIONS=java,py
# Comma-separated dirs to ignore: .git,__pycache__,node_modules,venv,.venv,target,build,dist
IGNORED_DIRS=.git,__pycache__,node_modules,venv,.venv,target,build,dist,.idea,.vscode

# --- Output ---
DEFAULT_OUTPUT_FILENAME=architecture.gaphor

# --- RAG / Embeddings ---
# Set to 'true' to enable ChromaDB-backed RAG knowledge base
ENABLE_RAG=false
CHROMA_PERSIST_DIR=./chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2
