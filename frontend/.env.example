# Base URL for the ArchiGen REST API.
#
# In development the Vite dev server proxies `/api/*` to http://localhost:8000
# and strips the prefix (see vite.config.js), so the default works as-is.
# Point this at an absolute URL to talk to a remote backend.
VITE_API_BASE_URL=/api

# When "true" the UI serves canned responses from src/api/mock.js and never
# contacts the backend. Handy for reviewing the interface on its own.
VITE_USE_MOCK=false

# PlantUML server used to render diagrams in the browser. Diagram source is
# sent to this host, so point it at a local instance to keep it on your machine
# (e.g. http://localhost:8080/plantuml).
VITE_PLANTUML_SERVER=https://www.plantuml.com/plantuml
